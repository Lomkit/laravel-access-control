{
  "name": "lomkit/laravel-access-control",
  "description": "A Laravel package that declares in one control who can see and change each Eloquent model: its perimeters drive the policies, the query scopes and the Scout searches.",
  "keywords": ["laravel", "eloquent", "authorization", "access-control", "policies", "permissions", "query-scopes", "multi-tenancy", "row-level-security", "scout", "lomkit"],
  "homepage": "https://laravel-access-control.lomkit.com",
  "license": "MIT",
  "authors": [
    {
      "name": "Gautier Deleglise",
      "email": "gautier@lomkit.com"
    }
  ],
  "support": {
    "docs": "https://laravel-access-control.lomkit.com",
    "issues": "https://github.com/Lomkit/laravel-access-control/issues",
    "source": "https://github.com/Lomkit/laravel-access-control"
  },
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.14",
    "laravel/pint": "^1.30",
    "laravel/scout": "^11.0",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpunit/phpunit": "^12.0 || ^13.0",
    "tomasvotruba/type-coverage": "^2.5"
  },
  "suggest": {
    "laravel/scout": "Filters Scout searches by the access keys that the ControlledSearchable trait indexes with each document."
  },
  "autoload": {
    "psr-4": {
      "Lomkit\\Access\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lomkit\\Access\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint",
    "lint": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lomkit\\Access\\AccessServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
