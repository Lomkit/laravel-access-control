{
  "name": "lomkit/laravel-access-control",
  "description": "A package to help you manage your laravel application access rights.",
  "keywords": ["laravel", "access", "control", "lomkit", "security"],
  "license": "MIT",
  "authors": [
    {
      "name": "Gautier Deleglise",
      "email": "gautier@lomkit.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "laravel/framework": "^12.0|^13.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^6.0|^7.0",
    "larastan/larastan": "^3.14",
    "laravel/pint": "^1.30",
    "laravel/scout": "^10|^11",
    "orchestra/testbench": "^10|^11",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpunit/phpunit": "^11.0|^12.0|^13.0",
    "tomasvotruba/type-coverage": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "Lomkit\\Access\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lomkit\\Access\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint",
    "lint": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lomkit\\Access\\AccessServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
