includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon

parameters:
    paths:
        - src
        # Analyses the HasControl trait through a model that uses it
        - tests/Fixtures/Discovery/Models/Note.php
        # Analyses the InteractsWithAccess trait through a test case that uses it
        - tests/Fixtures/Testing/AccessTestCase.php
        # Analyses the ControlledSearchable trait through a model that uses it
        - tests/Fixtures/Search/Article.php
        # Analyses the ReindexesSearch trait through a pivot that uses it
        - tests/Fixtures/Search/ArticleReviewer.php
    level: 10
    phpVersion: 80300
    checkMissingOverrideMethodAttribute: true
    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 100
